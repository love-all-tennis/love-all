# Copy to .env (never commit .env). `pnpm dev:api` and `pnpm db:migrate` load it automatically;
# variables already set in your shell win over this file.
POSTGRES_PASSWORD=love_all
# The local Postgres from `pnpm db:up`. Keep the password in step with POSTGRES_PASSWORD.
DATABASE_URL=postgres://love_all:love_all@localhost:5432/love_all
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated. The app's scheme plus the Expo dev server for web.
TRUSTED_ORIGINS=loveall://,http://localhost:8081
# Auth rate limiting keys on the client IP. Behind a reverse proxy, either name the header it sets
# with the client IP (comma-separated, default x-forwarded-for), or list the proxy IPs/CIDR ranges
# that append to x-forwarded-for. Leave both empty locally.
IP_ADDRESS_HEADERS=
TRUSTED_PROXIES=

# Social sign-in. Each provider is off until both its id and secret are set.
# Google: comma-separated OAuth client ids, web client first, then iOS and Android.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: comma-separated, the Services ID (web flow) first, then the app's bundle id.
# The secret is the client-secret JWT signed with your Apple key (it expires after 6 months at most).
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# Push notifications go through Expo's push service. Only needed once "enhanced push security"
# is turned on for the Expo project (an access token from expo.dev).
EXPO_ACCESS_TOKEN=
